#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>

//////////////////////////////////////////////////////////////
// Vector2

struct Vector2 {
    float x, y;
};

float distance(Vector2 a, Vector2 b) {
    return std::sqrt(
        (a.x - b.x)*(a.x - b.x) +
        (a.y - b.y)*(a.y - b.y)
    );
}

//////////////////////////////////////////////////////////////
// Status + Element Type

enum StatusType {
    BURN,
    SLOW,
    STUN
};

enum ElementType {
    ELEMENT_FIRE,
    ELEMENT_WATER,
    ELEMENT_LIGHTNING,
    ELEMENT_WIND,
    ELEMENT_EARTH,
    ELEMENT_LIGHT
};

//////////////////////////////////////////////////////////////
// StatusEffect

struct StatusEffect {
    StatusType type;
    ElementType element;
    float duration;
    float value;
};

//////////////////////////////////////////////////////////////
// Enemy

class Enemy {
public:
    Vector2 position;
    float hp;
    float baseSpeed;
    float currentSpeed;
    bool alive;

    std::vector<StatusEffect> effects;

    Enemy(float x, float y) {
        position = {x, y};
        hp = 200;
        baseSpeed = 40;
        currentSpeed = baseSpeed;
        alive = true;
    }

    void takeDamage(float dmg) {
        hp -= dmg;
        std::cout << "HP: " << hp << "\n";
        if (hp <= 0) {
            alive = false;
            std::cout << "Enemy Dead\n";
        }
    }

    void update(float dt) {

        currentSpeed = baseSpeed;

        for (auto& ef : effects) {

            ef.duration -= dt;

            if (ef.type == BURN)
                takeDamage(ef.value * dt);

            if (ef.type == SLOW)
                currentSpeed = baseSpeed * (1 - ef.value);

            if (ef.type == STUN)
                currentSpeed = 0;
        }

        effects.erase(
            std::remove_if(effects.begin(),
                           effects.end(),
                [](StatusEffect& e){
                    return e.duration <= 0;
                }),
            effects.end()
        );

        position.x += currentSpeed * dt;
    }
};

//////////////////////////////////////////////////////////////
// Element Base Class

class Element {
public:
    virtual void onApply(Enemy* target,
                         std::vector<Enemy*>& allEnemies) {}

    virtual float damageModifier() {
        return 1.0f;
    }
};

//////////////////////////////////////////////////////////////
// 🔥 Fire = Burn

class FireElement : public Element {
public:
    void onApply(Enemy* target,
                 std::vector<Enemy*>& allEnemies) override {

        StatusEffect burn;
        burn.type = BURN;
        burn.element = ELEMENT_FIRE;
        burn.duration = 3.0f;
        burn.value = 10;

        target->effects.push_back(burn);

        std::cout << "Burn Applied\n";
    }
};

//////////////////////////////////////////////////////////////
// 💧 Water = Slow

class WaterElement : public Element {
public:
    void onApply(Enemy* target,
                 std::vector<Enemy*>& allEnemies) override {

        StatusEffect slow;
        slow.type = SLOW;
        slow.element = ELEMENT_WATER;
        slow.duration = 2.0f;
        slow.value = 0.4f;

        target->effects.push_back(slow);

        std::cout << "Slow Applied\n";
    }
};

//////////////////////////////////////////////////////////////
// ⚡ Lightning = Chain

class LightningElement : public Element {
public:
    void onApply(Enemy* target,
                 std::vector<Enemy*>& allEnemies) override {

        std::cout << "Chain Lightning!\n";

        for (auto e : allEnemies) {
            if (distance(target->position,
                         e->position) < 80) {
                e->takeDamage(10);
            }
        }
    }
};

//////////////////////////////////////////////////////////////
// 🌪 Wind = Spread Status

class WindElement : public Element {
public:
    void onApply(Enemy* target,
                 std::vector<Enemy*>& allEnemies) override {

        std::cout << "Wind Spread!\n";

        for (auto enemy : allEnemies) {

            if (enemy == target) continue;

            if (distance(target->position,
                         enemy->position) < 100) {

                for (auto ef : target->effects) {
                    enemy->effects.push_back(ef);
                }
            }
        }
    }
};

//////////////////////////////////////////////////////////////
// 🌍 Earth = Heavy Damage

class EarthElement : public Element {
public:
    float damageModifier() override {
        return 1.5f;
    }
};

//////////////////////////////////////////////////////////////
// ✨ Light = Hit Scan (no CC)

class LightElement : public Element {
};

//////////////////////////////////////////////////////////////
// Tower Base

class Tower {
protected:
    Vector2 position;
    float damage;
    float cooldown;
    float attackSpeed;
    Element* element;

public:
    Tower(Vector2 pos,
          float dmg,
          float atkSpeed,
          Element* e) {

        position = pos;
        damage = dmg;
        attackSpeed = atkSpeed;
        cooldown = 0;
        element = e;
    }

    void attack(Enemy* target,
                std::vector<Enemy*>& enemies) {

        float finalDamage =
            damage * element->damageModifier();

        target->takeDamage(finalDamage);

        element->onApply(target, enemies);
    }

    void update(float dt,
                std::vector<Enemy*>& enemies) {

        cooldown -= dt;

        if (cooldown <= 0) {
            for (auto enemy : enemies) {
                if (enemy->alive) {
                    attack(enemy, enemies);
                    cooldown = attackSpeed;
                    break;
                }
            }
        }
    }
};

//////////////////////////////////////////////////////////////
// MAIN TEST

int main() {

    std::vector<Enemy*> enemies;
    enemies.push_back(new Enemy(100,100));
    enemies.push_back(new Enemy(140,100));
    enemies.push_back(new Enemy(180,100));

    FireElement fire;
    WindElement wind;

    Tower fireTower({0,0}, 30, 1.0f, &fire);
    Tower windTower({0,0}, 10, 2.0f, &wind);

    fireTower.update(0.1f, enemies); // ยิงไฟ
    windTower.update(0.1f, enemies); // ลมพัด Burn

    return 0;
}
